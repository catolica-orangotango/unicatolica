<?xml version="1.0" encoding="UTF-8"?>
<!--
    Voto anônimo (Story 8.3, RF56.1, RF57.1). Duas tabelas que não se ligam de propósito:

      enquete_participacao — QUEM votou (enquete + usuário). Garante um voto por usuário.
      enquete_voto         — O QUE foi votado (só a opção escolhida).

    NUNCA adicionar a enquete_voto coluna de identidade (usuario_id ou parecida), de data/hora
    (criado_em ou parecida) nem de agrupamento por voto: qualquer uma delas permitiria cruzar as
    duas tabelas e descobrir em quem cada pessoa votou. O teste EnqueteAnonimatoTest quebra se
    isso acontecer.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="enquetes-004-create-enquete-participacao" author="pacext">
        <createTable tableName="enquete_participacao">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="enquete_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_enquete_participacao_enquete"
                             references="enquete(id)" deleteCascade="true"/>
            </column>
            <!-- Só o id, sem FK: usuario é de Identidade (AD-3). -->
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <!-- Um voto por usuário e enquete (RF56.1): vale mesmo com duas requisições ao mesmo tempo. -->
        <addUniqueConstraint tableName="enquete_participacao" columnNames="enquete_id, usuario_id"
                             constraintName="uq_enquete_participacao_enquete_usuario"/>
        <!-- "Já votei?" para uma página de enquetes. -->
        <createIndex indexName="idx_enquete_participacao_usuario" tableName="enquete_participacao">
            <column name="usuario_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="enquetes-005-create-enquete-voto" author="pacext">
        <createTable tableName="enquete_voto">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="opcao_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_enquete_voto_opcao"
                             references="enquete_opcao(id)" deleteCascade="true"/>
            </column>
        </createTable>
        <!-- Contagem por opção (Story 8.5). -->
        <createIndex indexName="idx_enquete_voto_opcao" tableName="enquete_voto">
            <column name="opcao_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
