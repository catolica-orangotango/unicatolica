<?xml version="1.0" encoding="UTF-8"?>
<!--
    Tabelas perfil_academico e perfil_interesse — módulo Perfil Acadêmico (RF14–RF20,
    Stories 4.1–4.4). Nome e curso continuam em usuario (módulo Identidade): o perfil
    guarda só o que é dele, período (RF17) e interesses (RF18). usuario_id é só o id,
    sem FK (AD-3).
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="perfil-001-create-perfil-academico" author="pacext">
        <createTable tableName="perfil_academico">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_perfil_academico_usuario_id"/>
            </column>
            <column name="periodo" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="criado_em" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="atualizado_em" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <!-- Período do curso (RF17): o maior curso da instituição tem 12 semestres. -->
        <sql>ALTER TABLE perfil_academico ADD CONSTRAINT ck_perfil_academico_periodo CHECK (periodo BETWEEN 1 AND 12)</sql>
        <rollback>
            <sql>ALTER TABLE perfil_academico DROP CONSTRAINT ck_perfil_academico_periodo</sql>
        </rollback>
    </changeSet>

    <changeSet id="perfil-001-create-perfil-interesse" author="pacext">
        <!-- Interesses (RF18) em tabela própria, não array: a Busca (Epic 9) vai filtrar por eles. -->
        <createTable tableName="perfil_interesse">
            <column name="perfil_academico_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_perfil_interesse_perfil_academico"
                        references="perfil_academico(id)" deleteCascade="true"/>
            </column>
            <column name="interesse" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="perfil_interesse" columnNames="perfil_academico_id, interesse"
                constraintName="pk_perfil_interesse"/>
        <sql>ALTER TABLE perfil_interesse ADD CONSTRAINT ck_perfil_interesse_interesse CHECK (length(trim(interesse)) > 0)</sql>
        <rollback>
            <sql>ALTER TABLE perfil_interesse DROP CONSTRAINT ck_perfil_interesse_interesse</sql>
        </rollback>
        <createIndex indexName="idx_perfil_interesse_interesse" tableName="perfil_interesse">
            <column name="interesse"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
