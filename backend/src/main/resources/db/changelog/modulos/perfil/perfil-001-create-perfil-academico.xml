<?xml version="1.0" encoding="UTF-8"?>
<!--
    Tabelas perfil_academico e perfil_interesse — módulo Perfil Acadêmico (Epic 4).
    Guardam só o que não está em identidade.usuario: periodo e interesses. Nome/curso
    continuam só em usuario (Identidade) — ver package-info.java do módulo perfil e
    docs/decisoes/2026-09-26-modelo-epico-4-perfil.md.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="perfil-001-create-perfil-academico" author="pacext">
        <createTable tableName="perfil_academico">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_perfil_academico_usuario_id"/>
            </column>
            <column name="periodo" type="INTEGER"/>
            <column name="criado_em" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="atualizado_em" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

    <changeSet id="perfil-001-create-perfil-interesse" author="pacext">
        <createTable tableName="perfil_interesse">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="perfil_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_perfil_interesse_perfil"
                        references="perfil_academico(id)"/>
            </column>
            <!-- Sem coluna de ordem própria: @OrderBy("id ASC") no lado Java já basta,
                 porque a lista é sempre substituída por inteiro a cada edição (RF18) — ver
                 o javadoc de PerfilAcademico.interesses. -->
            <column name="texto" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_perfil_interesse_perfil_id" tableName="perfil_interesse">
            <column name="perfil_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
