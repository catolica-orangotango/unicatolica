<?xml version="1.0" encoding="UTF-8"?>
<!--
    Situação da conta (KAN-83): o administrador desativa e reativa contas pela tela
    "Usuários" de /admin. Conta desativada não faz login e perde a sessão ativa
    (identidade.aplicacao.UsuarioAdminService). Todo usuário existente continua ativo.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="identidade-009-add-ativo" author="pacext">
        <addColumn tableName="usuario">
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
