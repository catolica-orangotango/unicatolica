    <changeSet id="identidade-005-add-usuario-curso-id" author="pacext">
        <addColumn tableName="usuario">
            <column name="curso_id" type="BIGINT">
                <!-- Mesmo módulo (identidade): FK normal é permitida (AD-3). -->
                <constraints foreignKeyName="fk_usuario_curso" references="curso(id)"/>
            </column>
        </addColumn>
        <createIndex indexName="idx_usuario_curso_id" tableName="usuario">
            <column name="curso_id"/>
        </createIndex>
        <!--
            Liga as contas existentes pelo texto digitado no cadastro antigo, sem diferença
            de maiúsculas/espaços, e troca esse texto pelo nome oficial. Texto que não casa
            com nenhum curso fica como está, com curso_id nulo (Perfil.curso = null).
        -->
        <sql>
            UPDATE usuario u
               SET curso_id = c.id, curso = c.nome
              FROM curso c
             WHERE u.curso IS NOT NULL
               AND lower(trim(u.curso)) = lower(c.nome)
        </sql>
        <rollback>
            <dropColumn tableName="usuario" columnName="curso_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
