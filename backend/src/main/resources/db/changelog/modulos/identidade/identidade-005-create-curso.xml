<?xml version="1.0" encoding="UTF-8"?>
<!--
    Tabela curso — módulo Identidade (decisão de 2026-09-30: curso deixa de ser texto
    livre). Lista inicial = os 26 cursos das comunidades de curso do seed
    (comunidades-002); cadastro/edição pelo administrador fica no KAN-44.

    usuario.curso_id passa a ser a fonte de verdade. A coluna usuario.curso (texto)
    continua, com o nome oficial do curso escolhido, para quem só lê o nome
    (UsuarioResumo, Home, auto-join por nome) não mudar; a remoção dela está no KAN-44.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="identidade-005-create-curso" author="pacext">
        <createTable tableName="curso">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="criado_em" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <!-- Nome único sem diferença de maiúsculas: o auto-join casa curso e comunidade pelo nome. -->
        <sql>CREATE UNIQUE INDEX uk_curso_nome ON curso (lower(nome))</sql>
        <sql>ALTER TABLE curso ADD CONSTRAINT ck_curso_nome CHECK (length(trim(nome)) > 0)</sql>
        <rollback>
            <dropTable tableName="curso"/>
        </rollback>
    </changeSet>

