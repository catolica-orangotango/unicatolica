<?xml version="1.0" encoding="UTF-8"?>
<!--
    Exclusão lógica de comunidade (Story 2.6, RF31): comunidade excluída some das
    listagens e deixa de aceitar interações, mas os dados são preservados.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="comunidades-003-add-ativa-comunidade" author="pacext">
        <addColumn tableName="comunidade">
            <column name="ativa" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
