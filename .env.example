# Ambiente local reprodutível (AD-7). Copie para `.env` e ajuste se precisar —
# `.env` nunca é commitado (ver .gitignore). Segredos reais (produção) só via
# variáveis de ambiente do provedor de hosting, nunca aqui.

# Postgres (docker-compose "db" e datasource do backend)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pacext
DB_USER=pacext
DB_PASSWORD=pacext

# Segurança JWT (AD-2) — issuer esperado nos tokens validados pelo JwtSecurityFilter
JWT_ISSUER=https://pacext.unicatolica.edu.br

# Par de chaves RSA para assinar/validar o JWT de sessão. NUNCA commitar chaves reais
# aqui nem em arquivo — gere um par local (uma vez) com:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out /tmp/private.pem
#   openssl rsa -pubout -in /tmp/private.pem -out /tmp/public.pem
# Depois extraia só o base64 (sem headers/quebras de linha, uma linha só) e cole abaixo
# no seu .env local:
#   awk '/BEGIN/{next} /END/{next} {printf "%s", $0}' /tmp/private.pem
#   awk '/BEGIN/{next} /END/{next} {printf "%s", $0}' /tmp/public.pem
# Em produção, defina via variável de ambiente do provedor de hosting (mesmo formato).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# CORS (AD-2/AD-6) — origem liberada para o Angular dev server
CORS_ORIGINS=http://localhost:4200

# Frontend — URL base da API que a SPA Angular vai consumir. Reservada para quando
# o frontend passar a ler config de ambiente (nenhuma tela/serviço Angular lê esta
# variável ainda nesta história de scaffold).
API_URL=http://localhost:8080

# E-mail (DT-4) — trocar de provedor é só configuração. Sem nada aqui, o dev local usa a
# mailbox mock do Quarkus: o e-mail de confirmação aparece no log do quarkus:dev.
#
# Transporte: smtp (padrão) ou brevo-api.
#EMAIL_TRANSPORTE=smtp
# Remetente. Sem domínio próprio, precisa ser um endereço verificado no provedor
# (Brevo: Senders, Domains & Dedicated IPs → Senders).
#MAIL_FROM=no-reply@pacext.unicatolica.edu.br
#MAIL_FROM_NOME=UniCatólica
#
# --- Opção A: API HTTP da Brevo (produção no Render free, que bloqueia SMTP de saída) ---
#EMAIL_TRANSPORTE=brevo-api
# Chave em Brevo: SMTP & API → API Keys.
#BREVO_API_KEY=
#
# --- Opção B: qualquer provedor SMTP (Brevo, Resend, Gmail, SMTP institucional) ---
# Exemplo Brevo; para outro provedor, troque só host/porta/credenciais.
#EMAIL_TRANSPORTE=smtp
#QUARKUS_MAILER_HOST=smtp-relay.brevo.com
#QUARKUS_MAILER_PORT=587
#QUARKUS_MAILER_START_TLS=REQUIRED
# Login e chave SMTP em Brevo: SMTP & API → SMTP.
#QUARKUS_MAILER_USERNAME=
#QUARKUS_MAILER_PASSWORD=
# Em dev o Quarkus usa a mailbox mock mesmo com host definido; para enviar de verdade
# localmente, desligue o mock:
#QUARKUS_MAILER_MOCK=false
